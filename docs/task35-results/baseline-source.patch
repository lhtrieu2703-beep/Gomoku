+            for (char c : VI_ONLY_CHARS.toCharArray()) {
+                if (pt.indexOf(c) >= 0) {
+                    failures.add("PT." + m.getName() + "() chứa ký tự VI '" + c
+                        + "': \"" + pt + "\"");
+                }
+            }
+        }
+
+        // Cũng kiểm connectingMsg
+        Lang.set(Lang.Language.PT);
+        String ptConn = Lang.connectingMsg("1.2.3.4");
+        for (char c : VI_ONLY_CHARS.toCharArray()) {
+            if (ptConn.indexOf(c) >= 0) {
+                failures.add("PT.connectingMsg() chứa ký tự VI '" + c
+                    + "': \"" + ptConn + "\"");
+            }
+        }
+
+        if (!failures.isEmpty()) {
+            fail("[A] FAILURES:\n" + String.join("\n", failures));
+        }
+        System.out.println("[A] PASS – không có ký tự VI trong bản PT");
+    }
+
+    // =========================================================================
+    // CA B – bản EN chỉ chứa ASCII
+    // =========================================================================
+    @Test
+    @Order(2)
+    @DisplayName("B – EN chỉ chứa ASCII (0x00-0x7F)")
+    void b_enAsciiOnly() throws Exception {
+        List<Method> methods = getNoArgStringMethods();
+        System.out.println("[B] Kiểm " + methods.size() + " methods với bản EN");
+
+        List<String> failures = new ArrayList<>();
+        for (Method m : methods) {
+            Lang.set(Lang.Language.EN);
+            String en = (String) m.invoke(null);
+            for (int i = 0; i < en.length(); i++) {
+                char c = en.charAt(i);
+                if (c > 0x7F) {
+                    failures.add("EN." + m.getName() + "() chứa non-ASCII U+"
+                        + String.format("%04X", (int) c) + " '" + c
+                        + "': \"" + en + "\"");
+                    break; // chỉ báo 1 lần mỗi method
+                }
+            }
+        }
+
+        // connectingMsg
+        Lang.set(Lang.Language.EN);
+        String enConn = Lang.connectingMsg("1.2.3.4");
+        for (int i = 0; i < enConn.length(); i++) {
+            char c = enConn.charAt(i);
+            if (c > 0x7F) {
+                failures.add("EN.connectingMsg() chứa non-ASCII U+"
+                    + String.format("%04X", (int) c) + ": \"" + enConn + "\"");
+                break;
+            }
+        }
+
+        if (!failures.isEmpty()) {
+            fail("[B] FAILURES:\n" + String.join("\n", failures));
+        }
+        System.out.println("[B] PASS – toàn bộ EN là ASCII thuần");
+    }
+
+    // =========================================================================
+    // CA C – contrast ratio combo display field >= 4.5 (WCAG AA)
+    // =========================================================================
+    @Test
+    @Order(3)
+    @DisplayName("C – Combo display field: contrast ratio nền/chữ >= 4.5 (WCAG AA)")
+    void c_comboContrastRatio() throws Exception {
+        System.setProperty("java.awt.headless", "false");
+        Lang.set(Lang.Language.VI);
+        MainFrame frame = new MainFrame(new AppSettings(
+                Preferences.userRoot().node(TEST_NODE + "/c")));
+        try {
+            // Màu nền ô display (bgColor) và màu chữ (fgColor) từ applyDarkComboUI:
+            //   bgColor = RGB(55, 58, 65)
+            //   fgColor = Color.WHITE = RGB(255, 255, 255)
+            Color bg = new Color(55, 58, 65);
+            Color fg = Color.WHITE;
+
+            double cr = contrastRatio(bg, fg);
+            System.out.printf("[C] bg=RGB(%d,%d,%d) fg=WHITE → contrast ratio = %.2f%n",
+                bg.getRed(), bg.getGreen(), bg.getBlue(), cr);
+
+            assertTrue(cr >= 4.5,
+                "Contrast ratio " + String.format("%.2f", cr) + " < 4.5 (WCAG AA)");
+
+            // Kiểm thêm: selected state (selBg = 80,60,140) vs fgColor = WHITE
+            Color selBg = new Color(80, 60, 140);
+            double crSel = contrastRatio(selBg, fg);
+            System.out.printf("[C] selBg=RGB(%d,%d,%d) fg=WHITE → contrast ratio selected = %.2f%n",
+                selBg.getRed(), selBg.getGreen(), selBg.getBlue(), crSel);
+            assertTrue(crSel >= 3.0,
+                "Contrast ratio selected " + String.format("%.2f", crSel) + " < 3.0");
+
+            System.out.println("[C] PASS");
+        } finally {
+            frame.dispose();
+            try { Preferences.userRoot().node(TEST_NODE + "/c").removeNode(); }
+            catch (Exception ignored) {}
+        }
+    }
+
+    // =========================================================================
+    // Helpers
+    // =========================================================================
+    private List<Method> getNoArgStringMethods() {
+        List<Method> result = new ArrayList<>();
+        for (Method m : Lang.class.getDeclaredMethods()) {
+            if (Modifier.isPublic(m.getModifiers())
+                    && Modifier.isStatic(m.getModifiers())
+                    && m.getReturnType() == String.class
+                    && m.getParameterCount() == 0) {
+                result.add(m);
+            }
+        }
+        return result;
+    }
+
+    private double contrastRatio(Color c1, Color c2) {
+        double l1 = relativeLuminance(c1);
+        double l2 = relativeLuminance(c2);
+        double lighter = Math.max(l1, l2);
+        double darker  = Math.min(l1, l2);
+        return (lighter + 0.05) / (darker + 0.05);
+    }
+
+    private double relativeLuminance(Color c) {
+        double r = srgb(c.getRed()   / 255.0);
+        double g = srgb(c.getGreen() / 255.0);
+        double b = srgb(c.getBlue()  / 255.0);
+        return 0.2126 * r + 0.7152 * g + 0.0722 * b;
+    }
+
+    private double srgb(double v) {
+        return v <= 0.03928 ? v / 12.92 : Math.pow((v + 0.055) / 1.055, 2.4);
+    }
+}
diff --git a/test/game/NetworkStabilityTest.java b/test/game/NetworkStabilityTest.java
new file mode 100644
index 0000000..5c908a6
--- /dev/null
+++ b/test/game/NetworkStabilityTest.java
@@ -0,0 +1,174 @@
+package game;
+
+import game.network.NetworkManager;
+import org.junit.jupiter.api.Test;
+import java.io.*;
+import java.net.*;
+import java.nio.charset.StandardCharsets;
+import java.util.concurrent.*;
+import static org.junit.jupiter.api.Assertions.*;
+
+class NetworkStabilityTest {
+    static final class Events implements NetworkManager.NetworkListener {
+        final BlockingQueue<String> events = new LinkedBlockingQueue<>();
+        final BlockingQueue<Integer> ports = new LinkedBlockingQueue<>();
+        public void onHosting(int port) { ports.add(port); }
+        public void onConnected(boolean host) { events.add("connected:" + host); }
+        public void onMoveReceived(int r, int c) { events.add("move:" + r + ":" + c); }
+        public void onRestartRequested() { events.add("restart"); }
+        public void onOpponentDisconnected() { events.add("disconnected"); }
+        public void onError(NetworkManager.NetworkError error) { events.add("error:" + error.type()); }
+        String next() throws InterruptedException { return events.poll(3, TimeUnit.SECONDS); }
+    }
+
+    @Test
+    void cancelPendingHostReleasesPortWithoutError() throws Exception {
+        Events events = new Events();
+        NetworkManager manager = new NetworkManager(events);
+        try {
+            manager.hostGame(0);
+            Integer port = events.ports.poll(3, TimeUnit.SECONDS);
+            assertNotNull(port);
+            manager.disconnect();
+            try (ServerSocket rebound = new ServerSocket(port)) {
+                assertTrue(rebound.isBound());
+            }
+            assertFalse(manager.isConnected());
+            assertNull(events.events.poll(150, TimeUnit.MILLISECONDS));
+        } finally { manager.disconnect(); }
+    }
+
+    @Test
+    void hostAndClientExchangeMovesRestartAndDisconnect() throws Exception {
+        Events hostEvents = new Events();
+        Events clientEvents = new Events();
+        NetworkManager host = new NetworkManager(hostEvents);
+        NetworkManager client = new NetworkManager(clientEvents);
+        try {
+            host.hostGame(0);
+            Integer port = hostEvents.ports.poll(3, TimeUnit.SECONDS);
+            assertNotNull(port);
+            client.joinGame("127.0.0.1", port);
+            assertEquals("connected:true", hostEvents.next());
+            assertEquals("connected:false", clientEvents.next());
+            host.sendMove(7, 7);
+            assertEquals("move:7:7", clientEvents.next());
+            client.sendMove(6, 6);
+            assertEquals("move:6:6", hostEvents.next());
+            host.sendRestart();
+            assertEquals("restart", clientEvents.next());
+            client.disconnect();
+            assertEquals("disconnected", hostEvents.next());
+            assertFalse(host.isConnected());
+        } finally { client.disconnect(); host.disconnect(); }
+    }
+
+    @Test
+    void malformedMoveDoesNotKillConnectionAndOrderIsPreserved() throws Exception {
+        Events events = new Events();
+        NetworkManager manager = new NetworkManager(events);
+        try (ServerSocket server = new ServerSocket(0)) {
+            server.setSoTimeout(3000);
+            manager.joinGame("127.0.0.1", server.getLocalPort());
+            try (Socket peer = server.accept()) {
+                assertEquals("connected:false", events.next());
+                PrintWriter out = new PrintWriter(peer.getOutputStream(), true, StandardCharsets.UTF_8);
+                out.println("MOVE nope 4");
+                out.println("MOVE 1 2 3");
+                out.println("MOVE 4 5");
+                out.println("RESTART");
+                out.println("MOVE   6   7");
+                assertEquals("move:4:5", events.next());
+                assertEquals("restart", events.next());
+                assertEquals("move:6:7", events.next());
+                assertTrue(manager.isConnected());
+            }
+        } finally { manager.disconnect(); }
+    }
+
+    @Test
+    void callbacksAlreadyQueuedAreDiscardedAfterCancel() throws Exception {
+        Events events = new Events();
+        BlockingQueue<Runnable> callbacks = new LinkedBlockingQueue<>();
+        NetworkManager manager = new NetworkManager(events, callbacks::add);
+        try (ServerSocket server = new ServerSocket(0)) {
+            server.setSoTimeout(3000);
+            manager.joinGame("127.0.0.1", server.getLocalPort());
+            try (Socket peer = server.accept()) {
+                Runnable connected = callbacks.poll(3, TimeUnit.SECONDS);
+                assertNotNull(connected);
+                new PrintWriter(peer.getOutputStream(), true).println("MOVE 1 2");
+                Runnable move = callbacks.poll(3, TimeUnit.SECONDS);
+                assertNotNull(move);
+                manager.disconnect();
+                connected.run();
+                move.run();
+                assertTrue(events.events.isEmpty());
+            }
+        } finally { manager.disconnect(); }
+    }
+
+    @Test
+    void reconnectCannotBeClosedOrNotifiedByPreviousSession() throws Exception {
+        Events events = new Events();
+        BlockingQueue<Runnable> callbacks = new LinkedBlockingQueue<>();
+        NetworkManager manager = new NetworkManager(events, callbacks::add);
+        try (ServerSocket first = new ServerSocket(0); ServerSocket second = new ServerSocket(0)) {
+            first.setSoTimeout(3000); second.setSoTimeout(3000);
+            manager.joinGame("127.0.0.1", first.getLocalPort());
+            try (Socket oldPeer = first.accept()) {
+                Runnable oldConnected = callbacks.poll(3, TimeUnit.SECONDS);
+                assertNotNull(oldConnected);
+                manager.joinGame("127.0.0.1", second.getLocalPort());
+                try (Socket newPeer = second.accept()) {
+                    Runnable newConnected = callbacks.poll(3, TimeUnit.SECONDS);
+                    assertNotNull(newConnected);
+                    oldConnected.run(); newConnected.run();
+                    assertEquals("connected:false", events.next());
+                    oldPeer.setSoTimeout(3000);
+                    assertEquals(-1, oldPeer.getInputStream().read());
+                    new PrintWriter(newPeer.getOutputStream(), true).println("MOVE 8 9");
+                    Runnable move = callbacks.poll(3, TimeUnit.SECONDS);
+                    assertNotNull(move);
+                    move.run();
+                    assertEquals("move:8:9", events.next());
+                    assertTrue(manager.isConnected());
+                    assertTrue(events.events.isEmpty());
+                }
+            }
+        } finally { manager.disconnect(); }
+    }
+
+    @Test
+    void staleErrorIsDiscardedWhenNewSessionStarts() throws Exception {
+        Events events = new Events();
+        BlockingQueue<Runnable> callbacks = new LinkedBlockingQueue<>();
+        NetworkManager manager = new NetworkManager(events, callbacks::add);
+        try (ServerSocket occupied = new ServerSocket(0); ServerSocket next = new ServerSocket(0)) {
+            next.setSoTimeout(3000);
+            manager.hostGame(occupied.getLocalPort());
+            Runnable error = callbacks.poll(3, TimeUnit.SECONDS);
+            assertNotNull(error);
+            manager.joinGame("127.0.0.1", next.getLocalPort());
+            try (Socket peer = next.accept()) {
+                Runnable connected = callbacks.poll(3, TimeUnit.SECONDS);
+                assertNotNull(connected);
+                error.run(); connected.run();
+                assertEquals("connected:false", events.next());
+                assertTrue(events.events.isEmpty());
+                assertTrue(manager.isConnected());
+            }
+        } finally { manager.disconnect(); }
+    }
+
+    @Test
+    void occupiedPortReportsTypedHostError() throws Exception {
+        Events events = new Events();
+        NetworkManager manager = new NetworkManager(events);
+        try (ServerSocket occupied = new ServerSocket(0)) {
+            manager.hostGame(occupied.getLocalPort());
+            assertEquals("error:HOST", events.next());
+            assertFalse(manager.isConnected());
+        } finally { manager.disconnect(); }
+    }
+}
diff --git a/test/game/P1RegressionTest.java b/test/game/P1RegressionTest.java
new file mode 100644
index 0000000..05608da
--- /dev/null
+++ b/test/game/P1RegressionTest.java
@@ -0,0 +1,289 @@
+package game;
+
+import game.model.Board;
+import game.model.Piece;
+import game.view.*;
+import org.junit.jupiter.api.*;
+import org.junit.jupiter.params.ParameterizedTest;
+import org.junit.jupiter.params.provider.EnumSource;
+
+import javax.swing.*;
+import java.util.HashMap;
+import java.util.Map;
+import java.util.prefs.AbstractPreferences;
+
+import static org.junit.jupiter.api.Assertions.*;
+
+/** Regression tests run Swing on the EDT and never access production Preferences. */
+class P1RegressionTest {
+    private Lang.Language originalLanguage;
+    private boolean originalSound;
+
+    @BeforeEach
+    void setup() throws Exception {
+        SwingUtilities.invokeAndWait(() -> {
+            originalLanguage = Lang.get();
+            originalSound = SoundManager.isSoundEnabled();
+            SoundManager.setSoundEnabled(false);
+        });
+    }
+
+    @AfterEach
+    void restore() throws Exception {
+        SwingUtilities.invokeAndWait(() -> {
+            Lang.set(originalLanguage);
+            SoundManager.setSoundEnabled(originalSound);
+        });
+    }
+
+    @ParameterizedTest
+    @EnumSource(BoardPanel.GameMode.class)
+    void languageChangePreservesActiveGame(BoardPanel.GameMode mode) throws Exception {
+        SwingUtilities.invokeAndWait(() -> {
+            MainFrame frame = new MainFrame(new AppSettings(new MemoryPreferences()));
+            try {
+                BoardPanel panel = frame.getBoardPanel();
+                if (mode == BoardPanel.GameMode.ONLINE) panel.setupOnlineGame(null, true);
+                else panel.setGameMode(mode);
+                assertTrue(panel.playMove(7, 7));
+                int gameId = panel.getGameId();
+                boolean thinking = panel.isAiThinking();
+                boolean canUndo = panel.canUndo();
+                frame.getScoreTracker().recordResult(gameId - 1, Piece.X);
+                for (Lang.Language language : Lang.Language.values()) {
+                    Lang.set(language);
+                    assertEquals(gameId, panel.getGameId());
+                    assertEquals(1, panel.getMoveHistory().size());
+                    assertEquals(Piece.O, panel.getCurrentTurn());
+                    assertEquals(mode, panel.getGameMode());
+                    assertEquals(thinking, panel.isAiThinking());
+                    assertEquals(canUndo, panel.canUndo());
+                    assertEquals(7, panel.getLastMoveRow());
+                    assertEquals(7, panel.getLastMoveCol());
+                    assertFalse(panel.isGameOver());
+                    assertEquals(1, frame.getScoreTracker().getHumanWins());
+                    assertEquals(Lang.mode(), frame.getLblMode().getText());
+                    assertEquals(mode == BoardPanel.GameMode.ONLINE ? Lang.onlineOpponentTurn()
+                            : mode == BoardPanel.GameMode.PV_AI ? Lang.aiThinking() : Lang.p2Turn(),
+                            statusText(frame));
+                }
+            } finally {
+                frame.getBoardPanel().resetGame(); // cancel a possible AI worker
+                frame.dispose();
+            }
+        });
+    }
+
+    @ParameterizedTest
+    @EnumSource(Piece.class)
+    void languageChangePreservesFinishedGameAndTranslatesResult(Piece winner) throws Exception {
+        SwingUtilities.invokeAndWait(() -> {
+            MainFrame frame = new MainFrame(new AppSettings(new MemoryPreferences()));
+            try {
+                BoardPanel panel = frame.getBoardPanel();
+                panel.setGameMode(BoardPanel.GameMode.PVP);
+                panel.setGameStateListener(null); // suppress the modal result popup in this test
+                if (winner == Piece.NONE) {
+                    for (int r = 0; r < Board.SIZE; r++) {
+                        for (int c = 0; c < Board.SIZE; c++) {
+                            int phase = r % 2 == 0 ? 0 : 2;
+                            panel.executeMoveForTest(r, c, (c + phase) % 4 < 2 ? Piece.X : Piece.O);
+                        }
+                    }
+                } else {
+                    for (int c = 0; c < 5; c++) panel.executeMoveForTest(7, c, winner);
+                }
+                assertTrue(panel.isGameOver());
+                int gameId = panel.getGameId();
+                int history = panel.getMoveHistory().size();
+                for (Lang.Language language : Lang.Language.values()) {
+                    Lang.set(language);
+                    assertTrue(panel.isGameOver());
+                    assertEquals(winner, panel.getWinner());
+                    assertEquals(gameId, panel.getGameId());
+                    assertEquals(history, panel.getMoveHistory().size());
+                    String expected = winner == Piece.NONE ? Lang.drawGame()
+                            : winner == Piece.X ? Lang.p1Wins() : Lang.p2Wins();
+                    assertEquals(expected, panel.getGameOverMessage());
+                    assertEquals(expected, statusText(frame));
+                }
+            } finally {
+                frame.dispose();
+            }
+        });
+    }
+
+    @ParameterizedTest
+    @EnumSource(value = Piece.class, names = {"X", "O"})
+    void pvpUndoAfterWinRestoresWinningPlayerTurn(Piece winner) throws Exception {
+        SwingUtilities.invokeAndWait(() -> {
+            Board board = new Board();
+            BoardPanel panel = new BoardPanel(board);
+            panel.setGameMode(BoardPanel.GameMode.PVP);
+            int gameId = panel.getGameId();
+            for (int c = 0; c < 4; c++) {
+                assertTrue(panel.playMove(winner == Piece.X ? 7 : 0, winner == Piece.X ? c : c * 2));
+                assertTrue(panel.playMove(winner == Piece.X ? 0 : 7, winner == Piece.X ? c * 2 : c));
+            }
+            if (winner == Piece.O) assertTrue(panel.playMove(2, 10));
+            assertTrue(panel.playMove(7, 4));
+            assertTrue(panel.isGameOver());
+            int history = panel.getMoveHistory().size();
+            panel.undoMove();
+            assertEquals(winner, panel.getCurrentTurn());
+            assertFalse(panel.isGameOver());
+            assertEquals(Piece.NONE, panel.getWinner());
+            assertNull(panel.getGameOverMessage());
+            assertEquals(Piece.NONE, board.getPiece(7, 4));
+            assertEquals(history - 1, panel.getMoveHistory().size());
+            assertEquals(gameId, panel.getGameId());
+            assertTrue(panel.playMove(7, 4));
+            assertEquals(winner, board.getPiece(7, 4));
+            assertTrue(panel.isGameOver());
+        });
+    }
+
+    @Test
+    void pvpUndoAfterDrawRestoresLastPlayerTurn() throws Exception {
+        SwingUtilities.invokeAndWait(() -> {
+            Board board = new Board();
+            BoardPanel panel = new BoardPanel(board);
+            panel.setGameMode(BoardPanel.GameMode.PVP);
+            // Draw fixture: no five-in-a-row; final square is X.
+            for (int r = 0; r < Board.SIZE; r++) {
+                for (int c = 0; c < Board.SIZE; c++) {
+                    if (r == 14 && c == 14) continue;
+                    int phase = r % 2 == 0 ? 0 : 2;
+                    int p = (c + phase) % 4;
+                    board.makeMove(r, c, p < 2 ? Piece.X : Piece.O);
+                }
+            }
+            assertTrue(panel.playMove(14, 14));
+            assertTrue(panel.isGameOver());
+            panel.undoMove();
+            assertFalse(panel.isGameOver());
+            assertEquals(Piece.X, panel.getCurrentTurn());
+            assertEquals(224, board.getMoveCount());
+        });
+    }
+
+    @Test
+    void onlineRejectsOpponentMoveOnLocalTurn() throws Exception {
+        Board board = new Board();
+        BoardPanel[] panel = new BoardPanel[1];
+        SwingUtilities.invokeAndWait(() -> {
+            panel[0] = new BoardPanel(board);
+            panel[0].setupOnlineGame(null, true);
+            panel[0].applyOpponentMove(5, 5);
+        });
+        SwingUtilities.invokeAndWait(() -> {
+            assertEquals(Piece.NONE, board.getPiece(5, 5));
+            assertTrue(panel[0].getMoveHistory().isEmpty());
+            assertEquals(Piece.X, panel[0].getCurrentTurn());
+        });
+    }
+
+    @ParameterizedTest
+    @EnumSource(value = BoardPanel.GameMode.class, names = {"PVP", "PV_AI"})
+    void onlineRejectsMoveAfterSwitchingMode(BoardPanel.GameMode mode) throws Exception {
+        Board board = new Board();
+        BoardPanel[] panel = new BoardPanel[1];
+        SwingUtilities.invokeAndWait(() -> {
+            panel[0] = new BoardPanel(board);
+            panel[0].setupOnlineGame(null, false);
+            panel[0].setGameMode(mode);
+            panel[0].applyOpponentMove(5, 5);
+        });
+        SwingUtilities.invokeAndWait(() -> assertEquals(0, board.getMoveCount()));
+    }
+
+    @ParameterizedTest
+    @EnumSource(value = Piece.class, names = {"X", "O"})
+    void onlineAcceptsOnlyOneMoveFromCorrectOpponent(Piece localPiece) throws Exception {
+        Board board = new Board();
+        BoardPanel[] panel = new BoardPanel[1];
+        SwingUtilities.invokeAndWait(() -> {
+            panel[0] = new BoardPanel(board);
+            panel[0].setupOnlineGame(null, localPiece == Piece.X);
+            if (localPiece == Piece.X) assertTrue(panel[0].playMove(7, 7));
+            panel[0].applyOpponentMove(5, 5);
+            panel[0].applyOpponentMove(6, 6);
+        });
+        SwingUtilities.invokeAndWait(() -> {
+            assertEquals(localPiece.opposite(), board.getPiece(5, 5));
+            assertEquals(Piece.NONE, board.getPiece(6, 6));
+            assertEquals(localPiece, panel[0].getCurrentTurn());
+            assertEquals(localPiece == Piece.X ? 2 : 1, board.getMoveCount());
+        });
+    }
+
+    @Test
+    void onlineRejectsQueuedMoveAfterNewGame() throws Exception {
+        Board board = new Board();
+        BoardPanel[] panel = new BoardPanel[1];
+        SwingUtilities.invokeAndWait(() -> {
+            panel[0] = new BoardPanel(board);
+            panel[0].setupOnlineGame(null, false);
+            // Receive on a socket thread while the EDT is busy with a new game.
+            Thread receiver = new Thread(() -> panel[0].applyOpponentMove(5, 5));
+            receiver.start();
+            try {
+                receiver.join(1000);
+                assertFalse(receiver.isAlive());
+            } catch (InterruptedException e) {
+                throw new AssertionError(e);
+            }
+            panel[0].resetGame();
+        });
+        SwingUtilities.invokeAndWait(() -> assertEquals(0, board.getMoveCount()));
+    }
+
+    @Test
+    void onlineRejectsInvalidSquaresAndMovesAfterGameOver() throws Exception {
+        Board board = new Board();
+        BoardPanel[] panel = new BoardPanel[1];
+        SwingUtilities.invokeAndWait(() -> {
+            panel[0] = new BoardPanel(board);
+            panel[0].setupOnlineGame(null, true);
+            assertTrue(panel[0].playMove(7, 7));
+            panel[0].applyOpponentMove(-1, 5);
+            panel[0].applyOpponentMove(15, 5);
+            panel[0].applyOpponentMove(7, 7);
+        });
+        SwingUtilities.invokeAndWait(() -> {
+            assertEquals(1, board.getMoveCount());
+            assertEquals(Piece.O, panel[0].getCurrentTurn());
+            for (int c = 0; c < 5; c++) panel[0].executeMoveForTest(0, c, Piece.X);
+            assertTrue(panel[0].isGameOver());
+            panel[0].applyOpponentMove(5, 5);
+        });
+        SwingUtilities.invokeAndWait(() -> {
+            assertEquals(6, board.getMoveCount());
+            assertEquals(Piece.NONE, board.getPiece(5, 5));
+        });
+    }
+
+    private static String statusText(MainFrame frame) {
+        try {
